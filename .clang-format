---
Language: Cpp
BasedOnStyle: Google
Standard: c++20
UseTab: Never
IndentWidth: 2
ColumnLimit: 120
AccessModifierOffset: -2
DerivePointerAlignment: false
PointerAlignment: Left
AllowShortFunctionsOnASingleLine: InlineOnly
AllowShortIfStatementsOnASingleLine: Never
BreakBeforeBraces: Custom
BraceWrapping:
  BeforeElse: true
  BeforeCatch: true
SortIncludes: true
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^"'            # own headers
    Priority: 1
  - Regex: '^<Q'           # Qt headers
    Priority: 2
  - Regex: '^<'            # standard library and others
    Priority: 3
StatementAttributeLikeMacros: [Q_EMIT, emit]