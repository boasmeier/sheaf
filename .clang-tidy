{
  "Checks": "*, -llvmlibc*, -fuchsia-default-arguments-*, -fuchsia-trailing-return, -fuchsia-overloaded-operator, -modernize-use-trailing-return-type, -llvm-header-guard, -altera*",
  "HeaderFilterRegex": "modules\/.*(include|src).*",
  "CheckOptions": [
    {
      "key": "readability-identifier-naming.MemberSuffix",
      "value": "_"
    },
    {
      "key": "readability-identifier-naming.VariableCase",
      "value": "lower_case"
    },
    {
      "key": "readability-identifier-naming.ParameterCase",
      "value": "lower_case"
    },
    {
      "key": "readability-identifier-naming.FunctionCase",
      "value": "CamelCase"
    }
  ]
}